# ──────────────────────────────────────────────────────────────
# Variables de entorno del frontend
# Copia este archivo como .env.local y rellena los valores
# ──────────────────────────────────────────────────────────────

# URL del backend TRM en Railway
NEXT_PUBLIC_TRM_API_URL=https://backend-tmp-contenedores-production.up.railway.app

# URL del backend de autenticación en Railway
# Si el auth corre en el mismo backend, usa la misma URL
NEXT_PUBLIC_AUTH_API_URL=https://backend-tmp-contenedores-production.up.railway.app

# Base path para GitHub Pages (dejar vacío en desarrollo local)
# En producción el workflow lo inyecta como /trmp-contenedores
NEXT_PUBLIC_BASE_PATH=
